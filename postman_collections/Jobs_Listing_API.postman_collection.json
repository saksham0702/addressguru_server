{
  "info": {
    "_postman_id": "038bf3e7-f132-47da-99da-d7a641d402ca",
    "name": "Jobs Listing API - AddressGuru UAE",
    "description": "API endpoints for the Jobs Listing Module (2-Step Wizard, Retrieval, Metadata, and Management)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Core Listing (Wizard)",
      "item": [
        {
          "name": "1. Save Job (Step 1 - Core Details)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "category_id",
                  "value": "66447833a6ea9cd484edeb95",
                  "description": "REPLACE with a valid Category ObjectId",
                  "type": "text"
                },
                {
                  "key": "title",
                  "value": "Senior Full Stack Developer",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "We are looking for a highly skilled developer to join our growing team in Dubai.",
                  "type": "text"
                },
                {
                  "key": "sector",
                  "value": "it",
                  "type": "text"
                },
                {
                  "key": "jobType",
                  "value": "full-time",
                  "type": "text"
                },
                {
                  "key": "experienceLevel",
                  "value": "senior",
                  "type": "text"
                },
                {
                  "key": "requirements",
                  "value": "[\"Node.js\", \"React\", \"MongoDB\", \"AWS\"]",
                  "description": "JSON String Array",
                  "type": "text"
                },
                {
                  "key": "salary",
                  "value": "{\"from\": 15000, \"to\": 25000, \"currency\": \"AED\", \"period\": \"monthly\"}",
                  "description": "JSON String",
                  "type": "text"
                },
                {
                  "key": "location",
                  "value": "{\"city\": {\"_id\": \"CITY_ID\", \"name\": \"Dubai\"}, \"isRemote\": false}",
                  "description": "JSON String",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/jobs-listing/save-job/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "jobs-listing",
                "save-job",
                "1"
              ]
            }
          },
          "response": []
        },
        {
          "name": "2. Save Job (Step 2 - Contact, Media, SEO)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "job_id",
                  "value": "REPLACE_WITH_ID_FROM_STEP_1",
                  "description": "Paste the Job ID returned from Step 1 here",
                  "type": "text"
                },
                {
                  "key": "slug",
                  "value": "REPLACE_WITH_SLUG_FROM_STEP_1",
                  "description": "Paste the Job Slug returned from Step 1 here",
                  "type": "text"
                },
                {
                  "key": "folder",
                  "value": "Jobs",
                  "description": "Required by Multer to know where to save!",
                  "type": "text"
                },
                {
                  "key": "contact",
                  "value": "{\"name\": \"HR Manager\", \"email\": \"careers@techcorp.ae\", \"phone\": \"+971501234567\"}",
                  "type": "text"
                },
                {
                  "key": "company",
                  "value": "{\"name\": \"TechCorp Solutions\", \"size\": \"51-200\", \"website\": \"https://techcorp.ae\", \"description\": \"A growing tech company.\", \"address\": \"Business Bay, Dubai\", \"city\": \"Dubai\"}",
                  "type": "text"
                },
                {
                  "key": "logo",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "images",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/jobs-listing/save-job/2",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "jobs-listing",
                "save-job",
                "2"
              ]
            }
          },
          "response": []
        }
      ]
    },
