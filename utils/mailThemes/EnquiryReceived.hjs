<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>New Lead Received — AddressGuru UAE</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { background-color: #f8fafc; font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #1e293b; -webkit-font-smoothing: antialiased; line-height: 1.6; }
    .wrapper { width: 100%; padding: 48px 20px; background-color: #f8fafc; }
    .container { max-width: 600px; margin: 0 auto; background: #ffffff; border-radius: 20px; overflow: hidden; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.05); }

    .header { background: #ffffff; padding: 32px; text-align: center; border-bottom: 1px solid #f1f5f9; }
    .header-logo { height: 44px; width: auto; }

    .hero-section { background: linear-gradient(135deg, #f7941d 0%, #ffab40 100%); padding: 40px 32px; text-align: center; color: #ffffff; }
    .hero-icon { background: rgba(255, 255, 255, 0.2); width: 64px; height: 64px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; font-size: 28px; }
    .hero-title { font-size: 24px; font-weight: 700; margin-bottom: 8px; letter-spacing: -0.5px; }
    .hero-subtitle { font-size: 16px; opacity: 0.9; font-weight: 500; }

    .content { padding: 40px 32px; }
    .greeting { font-size: 18px; font-weight: 600; margin-bottom: 12px; color: #0f172a; }
    .intro-text { font-size: 15px; color: #64748b; margin-bottom: 32px; }

    .card { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 16px; padding: 24px; margin-bottom: 24px; }
    .card-title { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #94a3b8; margin-bottom: 16px; display: flex; align-items: center; gap: 8px; }
    
    .data-row { display: flex; margin-bottom: 12px; }
    .data-row:last-child { margin-bottom: 0; }
    .data-label { font-size: 13px; font-weight: 600; color: #64748b; width: 100px; flex-shrink: 0; }
    .data-value { font-size: 14px; font-weight: 500; color: #1e293b; flex: 1; }
    .data-value a { color: #f7941d; text-decoration: none; border-bottom: 1px solid rgba(247, 148, 29, 0.2); }

    .message-bubble { background: #ffffff; border-left: 4px solid #f7941d; padding: 16px; border-radius: 4px 12px 12px 4px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05); margin-top: 12px; }
    .message-text { font-size: 14px; color: #334155; font-style: italic; }

    .action-box { text-align: center; background: #fff7ed; border: 1px dashed #fdba74; border-radius: 16px; padding: 32px; margin-top: 8px; }
    .action-title { font-size: 16px; font-weight: 700; color: #9a3412; margin-bottom: 8px; }
    .action-desc { font-size: 14px; color: #c2410c; margin-bottom: 20px; }
    
    .cta-btn { display: inline-block; background: #f7941d; color: #ffffff !important; text-decoration: none; font-size: 15px; font-weight: 700; padding: 14px 32px; border-radius: 12px; box-shadow: 0 4px 12px rgba(247, 148, 29, 0.3); transition: transform 0.2s; }

    .footer { padding: 32px; text-align: center; border-top: 1px solid #f1f5f9; background: #fcfcfd; }
    .footer-links { margin-bottom: 16px; }
    .footer-links a { color: #64748b; text-decoration: none; font-size: 13px; margin: 0 12px; font-weight: 500; }
    .footer-text { font-size: 12px; color: #94a3b8; line-height: 1.8; }

    @media (max-width: 520px) {
      .wrapper { padding: 0; }
      .container { border-radius: 0; }
      .content { padding: 32px 20px; }
      .hero-section { padding: 32px 20px; }
      .data-row { flex-direction: column; }
      .data-label { margin-bottom: 4px; }
    }
  </style>
</head>
<body>
<div class="wrapper">
  <div class="container">
    <div class="header">
      <img class="header-logo" src="https://www.addressguru.in/images/logopng.png" alt="AddressGuru UAE" />
    </div>

    <div class="hero-section">
      <div class="hero-icon">📩</div>
      <h1 class="hero-title">New Enquiry Received!</h1>
      <p class="hero-subtitle">Someone is interested in your listing</p>
    </div>

    <div class="content">
      <p class="greeting">Hi {{ownerName}},</p>
      <p class="intro-text">
        Great news! You've received a new enquiry for <strong>{{businessName}}</strong>. Don't let this lead go cold — follow up as soon as possible.
      </p>

      <!-- Lead details -->
      <div class="card">
        <h2 class="card-title">Buyer Information</h2>
        <div class="data-row">
          <span class="data-label">Name</span>
          <span class="data-value">{{leadName}}</span>
        </div>
        <div class="data-row">
          <span class="data-label">Email</span>
          <span class="data-value"><a href="mailto:{{leadEmail}}">{{leadEmail}}</a></span>
        </div>
        <div class="data-row">
          <span class="data-label">Phone</span>
          <span class="data-value"><a href="tel:{{leadPhone}}">{{leadPhone}}</a></span>
        </div>
        
        {{#message}}
        <div class="message-bubble">
          <div class="data-label" style="margin-bottom: 4px;">Message</div>
          <p class="message-text">"{{previewMessage}}"</p>
        </div>
        {{/message}}
      </div>

      <!-- Action Area -->
      <div class="action-box">
        {{#isClaimed}}
        <h3 class="action-title">Manage Your Leads</h3>
        <p class="action-desc">View full details and manage all your enquiries in one place.</p>
        <a class="cta-btn" href="https://addressguru.ae/dashboard">Go to Dashboard</a>
        {{/isClaimed}}
        {{^isClaimed}}
        <h3 class="action-title">Is this your listing?</h3>
        <p class="action-desc">Claim your listing today to respond to this lead and unlock premium features.</p>
        <a class="cta-btn" href="https://addressguru.ae/{{listingSlug}}?claim=true">Claim Listing & Respond</a>
        {{/isClaimed}}
      </div>
    </div>

    <div class="footer">
      <div class="footer-links">
        <a href="https://addressguru.ae">Website</a>
        <a href="https://addressguru.ae/dashboard">Dashboard</a>
        <a href="mailto:support@addressguru.ae">Support</a>
      </div>
      <p class="footer-text">
        &copy; {{year}} AddressGuru UAE. All rights reserved.<br>
        Dubai, United Arab Emirates
      </p>
    </div>
  </div>
</div>
</body>
</html>
