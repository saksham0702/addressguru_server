<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Enquiry Confirmation — AddressGuru</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { background-color: #f4f4f6; font-family: 'DM Sans', sans-serif; color: #2d2d2d; -webkit-font-smoothing: antialiased; }
    .wrapper { width: 100%; padding: 40px 16px; background-color: #f4f4f6; }
    .container { max-width: 580px; margin: 0 auto; background: #ffffff; border-radius: 14px; overflow: hidden; box-shadow: 0 2px 20px rgba(0,0,0,0.07); }

    .header { background: #ffffff; padding: 0 32px; display: flex; align-items: center; justify-content: center; height: 72px; border-bottom: 1px solid #ebebeb; }
    .header-logo { display: block; height: 40px; width: auto; object-fit: contain; }

    .status-bar { background: #ecfdf5; border-bottom: 2px solid #10b981; padding: 12px 32px; display: flex; align-items: center; gap: 10px; }
    .status-dot { width: 8px; height: 8px; border-radius: 50%; background: #10b981; flex-shrink: 0; }
    .status-text { font-size: 13px; font-weight: 600; color: #065f46; letter-spacing: 0.2px; }

    .content { padding: 28px 32px 32px; }
    .greeting { font-size: 15px; color: #2d2d2d; line-height: 1.7; margin-bottom: 4px; }
    .greeting strong { color: #f7941d; }
    .intro-text { font-size: 13.5px; color: #666; line-height: 1.75; margin-bottom: 24px; }

    .info-box { border: 1px solid #e5e7eb; border-radius: 8px; overflow: hidden; margin-bottom: 20px; }
    .info-header { background: #f9fafb; border-bottom: 1px solid #e5e7eb; padding: 10px 16px; }
    .info-header-label { font-size: 11px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; color: #9ca3af; }
    .info-row { display: flex; align-items: flex-start; gap: 8px; padding: 11px 16px; border-bottom: 1px solid #f0f0f0; }
    .info-row:last-child { border-bottom: none; }
    .info-label { font-size: 11px; font-weight: 600; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.6px; min-width: 100px; padding-top: 1px; flex-shrink: 0; }
    .info-value { font-size: 13.5px; color: #374151; line-height: 1.5; flex: 1; }
    .info-value a { color: #f7941d; text-decoration: none; }

    .message-box { background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 8px; padding: 14px 16px; margin-bottom: 20px; }
    .message-label { font-size: 11px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; color: #9ca3af; margin-bottom: 8px; }
    .message-text { font-size: 13.5px; color: #374151; line-height: 1.7; }

    .cta-btn { display: inline-block; background: #f7941d; color: #fff; text-decoration: none; font-size: 13.5px; font-weight: 600; padding: 11px 24px; border-radius: 7px; }

    .footer { background: #f9fafb; border-top: 1px solid #ebebeb; padding: 18px 32px; text-align: center; }
    .footer-links { margin-bottom: 6px; }
    .footer-links a { color: #f7941d; text-decoration: none; font-size: 12.5px; font-weight: 500; margin: 0 8px; }
    .footer-copy { font-size: 11.5px; color: #aaa; line-height: 1.7; }

    @media (prefers-color-scheme: dark) {
      body, .wrapper { background-color: #111318; }
      .container { background: #1c1f2e; box-shadow: 0 4px 24px rgba(0,0,0,0.4); }
      .header { background: #f7941d; border-bottom-color: #e07a0a; }
      .status-bar { background: #064e3b; border-bottom-color: #065f46; }
      .status-text { color: #6ee7b7; }
      .greeting { color: #e8e8e8; }
      .intro-text { color: #9aa0b0; }
      .info-box { border-color: #2d3148; }
      .info-header { background: #13172a; border-bottom-color: #2d3148; }
      .info-label { color: #6b7280; }
      .info-value { color: #c9d0e0; }
      .info-row { border-bottom-color: #252840; }
      .message-box { background: #13172a; border-color: #2d3148; }
      .message-text { color: #c9d0e0; }
      .footer { background: #13172a; border-top-color: #2d3148; }
      .footer-copy { color: rgba(255,255,255,0.25); }
    }
  </style>
</head>
<body>
<div class="wrapper">
  <div class="container">

    <div class="header">
      <img class="header-logo" src="https://www.addressguru.in/images/logopng.png" alt="AddressGuru" />
    </div>

    <div class="status-bar">
      <div class="status-dot"></div>
      <span class="status-text">Enquiry Successfully Sent</span>
    </div>

    <div class="content">
      <p class="greeting">Hello, <strong>{{fullName}}</strong>,</p>
      <p class="intro-text">
        Thank you for your enquiry. We've sent your details to <strong>{{businessName}}</strong>. They will get back to you shortly.
      </p>

      <!-- Your Enquiry Details -->
      <div class="info-box">
        <div class="info-header"><span class="info-header-label">Details Sent</span></div>
        <div class="info-row">
          <span class="info-label">To Business</span>
          <span class="info-value">{{businessName}}</span>
        </div>
        {{#message}}
        <div class="info-row">
          <span class="info-label">Your Message</span>
          <span class="info-value">{{message}}</span>
        </div>
        {{/message}}
      </div>

      <div class="intro-text">
        If you have any questions, feel free to contact the listing owner directly or visit their listing page.
      </div>

      <a class="cta-btn" href="https://addressguru.ae/{{listingSlug}}">View Listing</a>
    </div>

    <div class="footer">
      <div class="footer-links">
        <a href="https://addressguru.ae">addressguru.ae</a>
        <a href="mailto:support@addressguru.ae">support@addressguru.ae</a>
      </div>
      <div class="footer-copy">&copy; {{year}} AddressGuru UAE. All rights reserved.</div>
    </div>

  </div>
</div>
</body>
</html>
