<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Listing Needs Updates — AddressGuru UAE</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: #f4f4f6;
      font-family: 'DM Sans', sans-serif;
      color: #000000;
      -webkit-font-smoothing: antialiased;
    }

    .wrapper {
      width: 100%;
      padding: 40px 16px;
      background-color: #f4f4f6;
    }

    .container {
      max-width: 580px;
      margin: 0 auto;
      background: #ffffff;
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 2px 20px rgba(0,0,0,0.07);
    }

    /* ── HEADER ── */
    .header {
      background: #ffffff;
      padding: 0 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      height: 72px;
      border-bottom: 2px solid #f7941d; /* Subtle brand touch */
    }
    .header-logo {
      display: block;
      height: 40px;
      width: auto;
      max-width: 100%;
      object-fit: contain;
    }

    /* ── BANNER ── */
    .banner {
      padding: 24px 32px 0;
      text-align: center;
    }
    .status-badge {
      display: inline-block;
      padding: 4px 12px;
      background: #fef2f2;
      color: #b91c1c;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      border-radius: 99px;
      border: 1px solid #fee2e2;
    }

    /* ── CONTENT ── */
    .content {
      padding: 30px 32px 32px;
    }

    .greeting {
      font-size: 15px;
      color: #000000;
      line-height: 1.7;
      margin-bottom: 6px;
    }
    .greeting strong { color: #f7941d; }

    .intro-text {
      font-size: 14px;
      color: #000000;
      line-height: 1.75;
      margin-bottom: 24px;
    }

    /* ── REJECTION BOX ── */
    .rejection-box {
      border: 1px solid #e5e7eb;
      border-radius: 6px;
      overflow: hidden;
      margin-bottom: 24px;
    }
    .rejection-header {
      background: #f9fafb;
      border-bottom: 1px solid #e5e7eb;
      padding: 10px 16px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .rejection-header-label {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: #000000;
    }
    .rejection-body {
      padding: 16px;
    }
    .rejection-body p {
      font-size: 14px;
      color: #000000;
      line-height: 1.75;
    }

    /* ── TIPS ── */
    .tips-section {
      margin-bottom: 0;
    }
    .tips-label {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: #000000;
      margin-bottom: 12px;
    }
    .tip-item {
      font-size: 13.5px;
      color: #000000;
      line-height: 1.65;
      padding: 9px 0 9px 16px;
      position: relative;
      border-bottom: 1px solid #f0f0f0;
    }
    .tip-item:last-child { border-bottom: none; }
    .tip-item::before {
      content: '→';
      position: absolute;
      left: 0;
      color: #f7941d;
      font-size: 11px;
      top: 11px;
    }

    /* ── FOOTER ── */
    .footer {
      background: #f9fafb;
      border-top: 1px solid #ebebeb;
      padding: 18px 32px;
      text-align: center;
    }
    .footer-links { margin-bottom: 6px; }
    .footer-links a {
      color: #f7941d;
      text-decoration: none;
      font-size: 12.5px;
      font-weight: 500;
      margin: 0 8px;
    }
    .footer-copy {
      font-size: 11.5px;
      color: #000000;
      line-height: 1.7;
    }

    /* ── DARK MODE ── */
    @media (prefers-color-scheme: dark) {
      body, .wrapper { background-color: #111318; }
      .container { background: #1c1f2e; box-shadow: 0 4px 24px rgba(0,0,0,0.4); }

      /* Header: orange background in dark mode */
      .header {
        background: #f7941d;
        border-bottom-color: #e07a0a;
      }

      .status-bar { background: #2a1010; border-bottom-color: #7f1d1d; }
      .status-text { color: #fca5a5; }
      .greeting { color: #e8e8e8; }
      .intro-text { color: #000000; }
      .rejection-box { border-color: #2d3148; }
      .rejection-header { background: #13172a; border-bottom-color: #2d3148; }
      .rejection-header-label { color: #000000; }
      .rejection-body p { color: #000000; }
      .tips-label { color: #000000; }
      .tip-item { color: #000000; border-bottom-color: #252840; }
      .footer { background: #13172a; border-top-color: #2d3148; }
      .footer-copy { color: rgba(255,255,255,0.25); }
    }

    /* ── MOBILE ── */
    @media (max-width: 520px) {
      .wrapper { padding: 0; }
      .container { border-radius: 0; box-shadow: none; }
      .header { padding: 0 20px; height: 64px; }
      .status-bar { padding: 11px 20px; }
      .content { padding: 22px 20px 24px; }
      .footer { padding: 16px 20px; }
    }
  </style>
</head>
<body>
<div class="wrapper">
  <div class="container">

    <!-- HEADER -->
    <div class="header">
      <img class="header-logo" src="https://www.addressguru.in/images/logopng.png" alt="AddressGuru UAE" />
    </div>

    <!-- BANNER -->
    <div class="banner">
      <span class="status-badge">Action Required</span>
    </div>

    <!-- CONTENT -->
    <div class="content">

      <p class="greeting">Hello, <strong>{{name}}</strong>,</p>
      <p class="intro-text">
        Thank you for submitting your listing on AddressGuru UAE. Our team reviewed it but was unable to approve it at this time. Please see the reason below and resubmit once updated.
      </p>

      <!-- REJECTION REASON -->
      <div class="rejection-box">
        <div class="rejection-header">
          <span class="rejection-header-label">Reason for Rejection</span>
        </div>
        <div class="rejection-body">
          <p>{{message}}</p>
        </div>
      </div>

      {{#adminNote}}
      <!-- ADMIN NOTES -->
      <div class="rejection-box" style="margin-bottom: 24px;">
        <div class="rejection-header">
          <span class="rejection-header-label">Note:</span>
        </div>
        <div class="rejection-body">
          <p>{{adminNote}}</p>
        </div>
      </div>
      {{/adminNote}}

      <!-- TIPS -->
      <div class="tips-section">
        <div class="tips-label">Common Issues to Check</div>
        <div class="tip-item">Ensure all required fields are filled in completely</div>
        <div class="tip-item">Upload clear, high-quality photos — no blurry or watermarked images</div>
        <div class="tip-item">Verify your contact details and business category are correct</div>
        <div class="tip-item">Make sure your listing is not a duplicate of an existing entry</div>
      </div>

    </div>

    <!-- FOOTER -->
    <div class="footer">
      <div class="footer-links">
        <a href="https://addressguru.ae">addressguru.ae</a>
        <a href="mailto:support@addressguru.ae">support@addressguru.ae</a>
      </div>
      <div class="footer-copy">
        &copy; {{year}} AddressGuru UAE. All rights reserved.
      </div>
    </div>

  </div>
</div>
</body>
</html>