<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Listing Needs Updates — AddressGuru</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: #f0f2f8;
      font-family: 'DM Sans', Arial, sans-serif;
      color: #2d2d2d;
      -webkit-font-smoothing: antialiased;
    }

    .wrapper {
      width: 100%;
      padding: 48px 16px;
      background-color: #f0f2f8;
    }

    .container {
      max-width: 600px;
      margin: 0 auto;
      background: #ffffff;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 8px 40px rgba(0,0,0,0.10);
    }

    /* ── HEADER ── */
    .header {
      background: linear-gradient(135deg, #f7941d 0%, #f5a623 50%, #ffb347 100%);
      position: relative;
      overflow: hidden;
    }
    .header-overlay {
      position: absolute; inset: 0;
      background-image:
        radial-gradient(circle at 15% 50%, rgba(255,255,255,0.12) 0%, transparent 50%),
        radial-gradient(circle at 85% 20%, rgba(255,255,255,0.08) 0%, transparent 40%);
    }
    .header-inner {
      position: relative;
      z-index: 1;
      text-align: center;
      padding: 40px 24px 36px;
    }
    .header-logo {
      display: block;
      margin: 0 auto 20px;
      height: 40px;
      width: auto;
    }
    .header-icon {
      width: 68px; height: 68px;
      background: rgba(255,255,255,0.22);
      border: 2px solid rgba(255,255,255,0.45);
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 18px;
    }
    .header-icon svg { width: 32px; height: 32px; fill: #fff; }
    .header-title {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 27px;
      font-weight: 700;
      color: #ffffff;
      letter-spacing: -0.3px;
      line-height: 1.25;
      margin-bottom: 8px;
    }
    .header-sub {
      font-size: 14px;
      color: rgba(255,255,255,0.85);
    }

    /* ── AMBER ACCENT ── */
    .accent-bar {
      height: 4px;
      background: linear-gradient(90deg, #ef4444, #f97316, #f7941d);
    }

    /* ── CONTENT ── */
    .content {
      padding: 36px 32px 28px;
    }
    .greeting {
      font-size: 17px;
      color: #2d2d2d;
      line-height: 1.7;
      margin-bottom: 6px;
    }
    .greeting strong { color: #f7941d; }

    .intro-text {
      font-size: 15px;
      color: #555;
      line-height: 1.75;
      margin-bottom: 22px;
    }

    /* ── ALERT BANNER ── */
    .alert-banner {
      background: linear-gradient(135deg, #fff7ed, #ffedd5);
      border: 1px solid #fdba74;
      border-radius: 12px;
      padding: 16px 20px;
      margin-bottom: 22px;
      display: flex;
      align-items: flex-start;
      gap: 13px;
    }
    .alert-icon {
      width: 38px; height: 38px; flex-shrink: 0;
      background: linear-gradient(135deg, #f97316, #ea580c);
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      margin-top: 2px;
    }
    .alert-icon svg { width: 18px; height: 18px; fill: #fff; }
    .alert-text strong { display: block; font-size: 15px; color: #c2410c; margin-bottom: 3px; }
    .alert-text span { font-size: 13px; color: #9a3412; }

    /* ── REASON BOX ── */
    .reason-section {
      margin-bottom: 24px;
    }
    .reason-title {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 1.3px;
      text-transform: uppercase;
      color: #f7941d;
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .reason-title::after {
      content: '';
      flex: 1;
      height: 1px;
      background: #ffe4b5;
    }
    .reason-box {
      background: #fff4f4;
      border: 1.5px solid #fca5a5;
      border-left: 4px solid #ef4444;
      border-radius: 0 10px 10px 0;
      padding: 18px 20px;
      color: #7f1d1d;
      font-size: 14px;
      line-height: 1.7;
    }

    /* ── TIPS CARD ── */
    .tips-card {
      background: #fffbf5;
      border: 1px solid #ffe4b5;
      border-radius: 14px;
      padding: 20px 22px;
      margin-bottom: 24px;
    }
    .tips-card-title {
      font-size: 13px;
      font-weight: 600;
      color: #f7941d;
      margin-bottom: 14px;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .tip-row {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      margin-bottom: 10px;
    }
    .tip-row:last-child { margin-bottom: 0; }
    .tip-dot {
      width: 20px; height: 20px; flex-shrink: 0;
      background: linear-gradient(135deg, #f7941d, #ffb347);
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      margin-top: 1px;
    }
    .tip-dot svg { width: 10px; height: 10px; fill: #fff; }
    .tip-text {
      font-size: 13px;
      color: #555;
      line-height: 1.6;
    }

    /* ── CTA ── */
    .cta-wrap { text-align: center; margin-bottom: 24px; }
    .btn-primary {
      display: inline-block;
      background: linear-gradient(135deg, #f7941d 0%, #ffb347 100%);
      color: #ffffff !important;
      text-decoration: none;
      padding: 15px 40px;
      border-radius: 50px;
      font-weight: 600;
      font-size: 15px;
      letter-spacing: 0.2px;
      box-shadow: 0 4px 18px rgba(247,148,29,0.35);
    }

    .support-note {
      background: #f8f9fc;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      padding: 14px 18px;
      font-size: 13px;
      color: #666;
      text-align: center;
      line-height: 1.65;
    }
    .support-note a {
      color: #f7941d;
      text-decoration: none;
      font-weight: 500;
    }

    /* ── FOOTER ── */
    .footer {
      background: #1c1f2e;
      padding: 28px 24px;
      text-align: center;
    }
    .footer-logo { height: 30px; opacity: 0.9; margin-bottom: 12px; }
    .footer-links { margin-bottom: 14px; }
    .footer-links a {
      color: #f7941d;
      text-decoration: none;
      font-size: 13px;
      font-weight: 500;
      margin: 0 10px;
    }
    .footer-copy {
      font-size: 12px;
      color: rgba(255,255,255,0.35);
      line-height: 1.7;
    }

    /* ── RESPONSIVE ── */
    @media (max-width: 520px) {
      .wrapper { padding: 24px 10px; }
      .header-title { font-size: 22px; }
      .content { padding: 24px 18px 20px; }
      .reason-box { padding: 14px 16px; }
      .btn-primary { width: 100%; text-align: center; padding: 14px 20px; }
      .alert-banner { flex-direction: column; }
    }
  </style>
</head>
<body>
<div class="wrapper">
  <div class="container">

    <!-- HEADER -->
    <div class="header">
      <div class="header-overlay"></div>
      <div class="header-inner">
        <img class="header-logo" src="https://www.addressguru.in/images/logopng.png" alt="AddressGuru" />
        {{!-- <div class="header-icon">
          <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
        </div> --}}
        <h1 class="header-title">Action Required</h1>
        <p class="header-sub">Your listing needs a few updates before it can go live.</p>
      </div>
    </div>
    <div class="accent-bar"></div>

    <!-- CONTENT -->
    <div class="content">
      <p class="greeting">Hello, <strong>{{name}}</strong>,</p>
      <p class="intro-text">
        Thank you for submitting your listing on <strong>AddressGuru UAE</strong>. Our team has reviewed your submission, but we were unable to approve it at this time. Please see the details below and resubmit once updated.
      </p>

      <!-- Alert Banner -->
      <div class="alert-banner">
        <div class="alert-icon">
          <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
        </div>
        <div class="alert-text">
          <strong>Listing Not Approved</strong>
          <span>Please review the reason below and update your listing to resubmit.</span>
        </div>
      </div>

      <!-- Rejection Reason -->
      <div class="reason-section">
        <div class="reason-title">❌ Reason for Rejection</div>
        <div class="reason-box">{{message}}</div>
      </div>

      <!-- Tips -->
      <div class="tips-card">
        <div class="tips-card-title">
          <svg viewBox="0 0 24 24" width="16" height="16" style="fill:#f7941d;flex-shrink:0"><path d="M9 21c0 .55.45 1 1 1h4c.55 0 1-.45 1-1v-1H9v1zm3-19C8.14 2 5 5.14 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.86-3.14-7-7-7z"/></svg>
          Common Issues to Check
        </div>
        <div class="tip-row">
          <div class="tip-dot"><svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg></div>
          <div class="tip-text">Ensure all required fields are filled in completely</div>
        </div>
        <div class="tip-row">
          <div class="tip-dot"><svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg></div>
          <div class="tip-text">Upload clear, high-quality photos (no blurry or watermarked images)</div>
        </div>
        <div class="tip-row">
          <div class="tip-dot"><svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg></div>
          <div class="tip-text">Verify your contact details and business category are correct</div>
        </div>
        <div class="tip-row">
          <div class="tip-dot"><svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg></div>
          <div class="tip-text">Make sure your listing is not a duplicate of an existing entry</div>
        </div>
      </div>

      <!-- CTA -->
      <div class="cta-wrap">
        <a href="{{dashboardUrl}}" class="btn-primary">Update My Listing →</a>
      </div>

      <!-- Support Note -->
      <div class="support-note">
        Need help? Our team is here for you.<br>
        Reach us at <a href="mailto:support@addressguru.ae">support@addressguru.ae</a> and we'll guide you through the process.
      </div>
    </div>

    <!-- FOOTER -->
    <div class="footer">
      <img class="footer-logo" src="https://www.addressguru.in/images/logopng.png" alt="AddressGuru" />
      <div class="footer-links">
        <a href="https://addressguru.ae">addressguru.ae</a>
        <a href="mailto:support@addressguru.ae">support@addressguru.ae</a>
      </div>
      <div class="footer-copy">
        &copy; {{year}} AddressGuru UAE. All rights reserved.<br>
        You're receiving this because your listing was reviewed on our platform.
      </div>
    </div>

  </div>
</div>
</body>
</html>
