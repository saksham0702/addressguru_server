<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Top Businesses — AddressGuru</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { background-color: #f4f4f6; font-family: 'DM Sans', sans-serif; color: #2d2d2d; -webkit-font-smoothing: antialiased; }
    .wrapper { width: 100%; padding: 40px 10px; background-color: #f4f4f6; }
    .container { max-width: 600px; margin: 0 auto; background: #ffffff; border-radius: 14px; overflow: hidden; box-shadow: 0 2px 20px rgba(0,0,0,0.07); }

    /* HEADER */
    .header { background: #ffffff; padding: 0 32px; display: flex; align-items: center; justify-content: center; height: 72px; border-bottom: 1px solid #ebebeb; }
    .header-logo { display: block; height: 40px; width: auto; max-width: 100%; object-fit: contain; }

    /* CATEGORY BANNER */
    .category-banner { background: #fff8f0; border-bottom: 2px solid #f7941d; padding: 14px 32px; text-align: center; }
    .category-title { font-size: 15px; font-weight: 600; color: #92400e; letter-spacing: 0.3px; }
    .category-title span { color: #f7941d; }

    /* CONTENT */
    .content { padding: 24px 32px 28px; }
    .greeting { font-size: 15px; color: #2d2d2d; line-height: 1.7; margin-bottom: 4px; }
    .greeting strong { color: #f7941d; }
    .intro-text { font-size: 13.5px; color: #666; line-height: 1.75; margin-bottom: 24px; }
    .section-label { font-size: 11px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; color: #9ca3af; margin-bottom: 14px; }

    /* BUSINESS CARD */
    .business-card { border: 1px solid #e5e7eb; border-radius: 8px; overflow: hidden; margin-bottom: 14px; }
    .business-card:last-child { margin-bottom: 0; }

    .card-head { display: flex; align-items: center; gap: 20px; padding: 16px 16px 14px; border-bottom: 1px solid #f0f0f0; background: #fafafa; }
    .card-logo-wrap { width: 68px; height: 68px; border-radius: 10px; border: 1px solid #e5e7eb; background: #fff; flex-shrink: 0; display: flex; align-items: center; justify-content: center; overflow: hidden; }
    .card-logo-wrap img { width: 100%; height: 100%; height: 68px; max-height: 68px; max-width: 68px; width: 68px; object-fit: contain; }
    .card-logo-placeholder { width: 100%; height: 100%; background: #fff8f0; display: flex; align-items: center; justify-content: center; font-size: 18px; font-weight: 700; color: #f7941d; }
    .card-title-block { flex: 1; min-width: 0; margin-left: 30px; }
    .card-business-name { font-size: 14.5px; font-weight: 600; color: #1f2937; line-height: 1.35; text-decoration: none; }
    .card-category-tag { display: inline-block; margin-top: 3px; font-size: 11px; font-weight: 500; color: #f7941d; background: #fff8f0; border: 1px solid #fcd9a8; border-radius: 4px; padding: 1px 7px; }

    .card-row { display: flex; align-items: flex-start; gap: 8px; padding: 9px 16px; border-bottom: 1px solid #f5f5f5; }
    .card-row:last-child { border-bottom: none; }
    .card-row-label { font-size: 11px; font-weight: 600; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.6px; min-width: 80px; padding-top: 1px; flex-shrink: 0; }
    .card-row-value { font-size: 11px; margin-left: 5px; color: #374151; line-height: 1.5; flex: 1; }
    .card-row-value a { color: #f7941d; text-decoration: none; font-weight: 500; }

    .phone-pill { display: inline-flex; align-items: center; gap: 5px; background: #fff8f0; border: 1px solid #fcd9a8; border-radius: 20px; padding: 3px 10px 3px 7px; font-size: 12.5px; font-weight: 500; color: #92400e; text-decoration: none; }
    .phone-pill::before { content: '📞'; font-size: 11px; }

    .card-cta { padding: 10px 16px; background: #fafafa; border-top: 1px solid #f0f0f0; text-align: right; }
    .card-cta a { font-size: 12px; font-weight: 600; color: #f7941d; text-decoration: none; letter-spacing: 0.2px; }
    .card-cta a::after { content: ' →'; }

    /* FOOTER */
    .footer { background: #f9fafb; border-top: 1px solid #ebebeb; padding: 18px 32px; text-align: center; }
    .footer-links { margin-bottom: 6px; }
    .footer-links a { color: #f7941d; text-decoration: none; font-size: 12.5px; font-weight: 500; margin: 0 8px; }
    .footer-copy { font-size: 11.5px; color: #aaa; line-height: 1.7; }

    /* DARK MODE */
    @media (prefers-color-scheme: dark) {
      body, .wrapper { background-color: #111318; }
      .container { background: #1c1f2e; box-shadow: 0 4px 24px rgba(0,0,0,0.4); }
      .header { background: #f7941d; border-bottom-color: #e07a0a; }
      .category-banner { background: #1c1400; border-bottom-color: #78350f; }
      .category-title { color: #fcd34d; }
      .category-title span { color: #f7941d; }
      .greeting { color: #e8e8e8; }
      .intro-text { color: #9aa0b0; }
      .section-label { color: #6b7280; }
      .business-card { border-color: #2d3148; }
      .card-head { background: #13172a; border-bottom-color: #2d3148; }
      .card-logo-wrap { border-color: #2d3148; background: #1c1f2e; }
      .card-logo-placeholder { background: #1c1400; }
      .card-business-name { color: #e8e8e8; }
      .card-row { border-bottom-color: #252840; }
      .card-row-label { color: #6b7280; }
      .card-row-value { color: #c9d0e0; }
      .card-cta { background: #13172a; border-top-color: #2d3148; }
      .footer { background: #13172a; border-top-color: #2d3148; }
      .footer-copy { color: rgba(255,255,255,0.25); }
    }

    /* MOBILE */
    @media (max-width: 520px) {
      .wrapper { padding: 0; }
      .container { border-radius: 0; box-shadow: none; }
      .header { padding: 0 20px; height: 64px; }
      .category-banner { padding: 12px 20px; }
      .content { padding: 20px 20px 24px; }
      .footer { padding: 16px 20px; }
    }
  </style>
</head>
<body>
<div class="wrapper">
  <div class="container">

    <!-- HEADER -->
    <div class="header">
      <img class="header-logo" src="https://www.addressguru.in/images/logopng.png" alt="AddressGuru" />
    </div>

    <!-- CATEGORY BANNER -->
    <div class="category-banner">
      <div class="category-title">Top Businesses in <span>{{category}}</span></div>
    </div>

    <!-- CONTENT -->
    <div class="content">
      <p class="greeting">Hello, <strong>{{name}}</strong></p>
      <p class="intro-text">
        Here are some of the best {{category}} businesses listed on AddressGuru UAE. Explore their details below.
      </p>

      <div class="section-label">Featured Listings</div>

      {{#businesses}}
      <div class="business-card">

        <!-- Logo + Name -->
        <div class="card-head">
          <div class="card-logo-wrap">
            {{#logoUrl}}
              <img src="https://addressguru.ae/api/{{logoUrl}}" alt="{{businessName}} logo" />
            {{/logoUrl}}
            {{^logoUrl}}
              <div class="card-logo-placeholder">{{initial}}</div>
            {{/logoUrl}}
          </div>
          <div class="card-title-block">
            <a class="card-business-name" href="https://addressguru.ae/{{slug}}">{{businessName}}</a>
            <div><span class="">{{businessAddress}}</span></div>
          </div>
        </div>

        <!-- Info Rows -->
        <div class="card-body">
          <div class="card-row">
            <span class="card-row-label">Contact Person: </span>
            <span class="card-row-value"> {{contactPerson}}</span>
          </div>
          <div class="card-row">
            <span class="card-row-label">Phone: </span>
            <span class="card-row-value">
              {{#phoneIsNA}}NA{{/phoneIsNA}}
              {{^phoneIsNA}}<a class="phone-pill" href="tel:{{phone}}">{{phone}}</a>{{/phoneIsNA}}
            </span>
          </div>
          <div class="card-row">
            <span class="card-row-label">Email: </span>
            <span class="card-row-value">
              {{#emailIsNA}}NA{{/emailIsNA}}
              {{^emailIsNA}}<a href="mailto:{{listingEmail}}">{{listingEmail}}</a>{{/emailIsNA}}
            </span>
          </div>
        </div>

        <!-- CTA -->
        <div class="card-cta">
          <a href="https://addressguru.ae/{{slug}}">View Details</a>
        </div>

      </div>
      {{/businesses}}

    </div>

    <!-- FOOTER -->
    <div class="footer">
      <div class="footer-links">
        <a href="https://addressguru.ae">addressguru.ae</a>
        <a href="mailto:support@addressguru.ae">support@addressguru.ae</a>
      </div>
      <div class="footer-copy">
        &copy; {{year}} AddressGuru UAE. All rights reserved.
      </div>
    </div>

  </div>
</div>
</body>
</html>
