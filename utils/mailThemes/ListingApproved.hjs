<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Listing Approved — AddressGuru</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: #f4f4f6;
      font-family: 'DM Sans', sans-serif;
      color: #2d2d2d;
      -webkit-font-smoothing: antialiased;
    }

    .wrapper {
      width: 100%;
      padding: 40px 16px;
      background-color: #f4f4f6;
    }

    .container {
      max-width: 580px;
      margin: 0 auto;
      background: #ffffff;
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 2px 20px rgba(0,0,0,0.07);
    }

    /* ── HEADER ── */
    .header {
      background: #ffffff;
      padding: 0 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      height: 72px;
      border-bottom: 1px solid #ebebeb;
    }
    .header-logo {
      display: block;
      height: 40px;
      width: auto;
      max-width: 100%;
      object-fit: contain;
    }

    /* ── STATUS BAR ── */
    .status-bar {
      background: #f0fdf4;
      border-bottom: 2px solid #86efac;
      padding: 12px 32px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #22c55e;
      flex-shrink: 0;
    }
    .status-text {
      font-size: 13px;
      font-weight: 600;
      color: #15803d;
      letter-spacing: 0.2px;
    }

    /* ── CONTENT ── */
    .content {
      padding: 30px 32px 32px;
    }

    .greeting {
      font-size: 15px;
      color: #2d2d2d;
      line-height: 1.7;
      margin-bottom: 6px;
    }
    .greeting strong { color: #f7941d; }

    .intro-text {
      font-size: 14px;
      color: #666;
      line-height: 1.75;
      margin-bottom: 24px;
    }

    /* ── INFO BOX ── */
    .info-box {
      border: 1px solid #e5e7eb;
      border-radius: 6px;
      overflow: hidden;
      margin-bottom: 24px;
    }
    .info-header {
      background: #f9fafb;
      border-bottom: 1px solid #e5e7eb;
      padding: 10px 16px;
    }
    .info-header-label {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: #9ca3af;
    }
    .info-body {
      padding: 0;
    }
    .info-row {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      padding: 11px 16px;
      border-bottom: 1px solid #f0f0f0;
    }
    .info-row:last-child { border-bottom: none; }
    .info-label {
      font-size: 11px;
      font-weight: 600;
      color: #9ca3af;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      min-width: 90px;
      padding-top: 1px;
    }
    .info-value {
      font-size: 13.5px;
      color: #374151;
      line-height: 1.5;
      flex: 1;
    }
    .info-value a {
      color: #f7941d;
      text-decoration: none;
      word-break: break-all;
    }

    /* ── TIPS ── */
    .tips-section {
      margin-bottom: 0;
    }
    .tips-label {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: #9ca3af;
      margin-bottom: 12px;
    }
    .tip-item {
      font-size: 13.5px;
      color: #555;
      line-height: 1.65;
      padding: 9px 0 9px 16px;
      position: relative;
      border-bottom: 1px solid #f0f0f0;
    }
    .tip-item:last-child { border-bottom: none; }
    .tip-item::before {
      content: '→';
      position: absolute;
      left: 0;
      color: #f7941d;
      font-size: 11px;
      top: 11px;
    }

    /* ── FOOTER ── */
    .footer {
      background: #f9fafb;
      border-top: 1px solid #ebebeb;
      padding: 18px 32px;
      text-align: center;
    }
    .footer-links { margin-bottom: 6px; }
    .footer-links a {
      color: #f7941d;
      text-decoration: none;
      font-size: 12.5px;
      font-weight: 500;
      margin: 0 8px;
    }
    .footer-copy {
      font-size: 11.5px;
      color: #aaa;
      line-height: 1.7;
    }

    /* ── DARK MODE ── */
    @media (prefers-color-scheme: dark) {
      body, .wrapper { background-color: #111318; }
      .container { background: #1c1f2e; box-shadow: 0 4px 24px rgba(0,0,0,0.4); }
      .header { background: #f7941d; border-bottom-color: #e07a0a; }
      .status-bar { background: #052e16; border-bottom-color: #166534; }
      .status-text { color: #86efac; }
      .greeting { color: #e8e8e8; }
      .intro-text { color: #9aa0b0; }
      .info-box { border-color: #2d3148; }
      .info-header { background: #13172a; border-bottom-color: #2d3148; }
      .info-header-label { color: #6b7280; }
      .info-label { color: #6b7280; }
      .info-value { color: #c9d0e0; }
      .info-row { border-bottom-color: #252840; }
      .tips-label { color: #6b7280; }
      .tip-item { color: #9aa0b0; border-bottom-color: #252840; }
      .footer { background: #13172a; border-top-color: #2d3148; }
      .footer-copy { color: rgba(255,255,255,0.25); }
    }

    /* ── MOBILE ── */
    @media (max-width: 520px) {
      .wrapper { padding: 0; }
      .container { border-radius: 0; box-shadow: none; }
      .header { padding: 0 20px; height: 64px; }
      .status-bar { padding: 11px 20px; }
      .content { padding: 22px 20px 24px; }
      .footer { padding: 16px 20px; }
    }
  </style>
</head>
<body>
<div class="wrapper">
  <div class="container">

    <!-- HEADER -->
    <div class="header">
      <img class="header-logo" src="https://www.addressguru.in/images/logopng.png" alt="AddressGuru" />
    </div>

    <!-- STATUS BAR -->
    <div class="status-bar">
      <div class="status-dot"></div>
      <span class="status-text">Listing Approved & Live</span>
    </div>

    <!-- CONTENT -->
    <div class="content">

      <p class="greeting">Hello, <strong>{{name}}</strong>,</p>
      <p class="intro-text">
        Great news! Your listing on AddressGuru UAE has been reviewed and approved. It is now live and visible to customers across the UAE.
      </p>

      <!-- LISTING DETAILS -->
      <div class="info-box">
        <div class="info-header">
          <span class="info-header-label">Your Listing Details</span>
        </div>
        <div class="info-body">
          <div class="info-row">
            <span class="info-label">Business</span>
            <span class="info-value">{{businessName}}</span>
          </div>
          <div class="info-row">
            <span class="info-label">Category</span>
            <span class="info-value">{{category}}</span>
          </div>
          <div class="info-row">
            <span class="info-label">Live URL</span>
            <span class="info-value"><a href="{{listingUrl}}">{{listingUrl}}</a></span>
          </div>
        </div>
      </div>

      <!-- NEXT STEPS -->
      <div class="tips-section">
        <div class="tips-label">What You Can Do Now</div>
        <div class="tip-item">Share your listing URL with customers and on social media</div>
        <div class="tip-item">Log in to your dashboard to update details anytime</div>
        <div class="tip-item">Add more photos to make your listing stand out</div>
        <div class="tip-item">Upgrade to a premium plan for priority placement and more visibility</div>
      </div>

    </div>

    <!-- FOOTER -->
    <div class="footer">
      <div class="footer-links">
        <a href="https://addressguru.ae">addressguru.ae</a>
        <a href="mailto:support@addressguru.ae">support@addressguru.ae</a>
      </div>
      <div class="footer-copy">
        &copy; {{year}} AddressGuru UAE. All rights reserved.
      </div>
    </div>

  </div>
</div>
</body>
</html>