<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Thank You for Your Review — AddressGuru UAE</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { background-color: #f4f4f6; font-family: 'DM Sans', sans-serif; color: #2d2d2d; -webkit-font-smoothing: antialiased; }
    .wrapper { width: 100%; padding: 40px 16px; background-color: #f4f4f6; }
    .container { max-width: 580px; margin: 0 auto; background: #ffffff; border-radius: 14px; overflow: hidden; box-shadow: 0 2px 20px rgba(0,0,0,0.07); }
    .header { background: #ffffff; padding: 0 32px; display: flex; align-items: center; justify-content: center; height: 72px; border-bottom: 1px solid #ebebeb; }
    .header-logo { display: block; height: 40px; width: auto; object-fit: contain; }
    .status-bar { background: #ecfdf5; border-bottom: 2px solid #10b981; padding: 12px 32px; display: flex; align-items: center; gap: 10px; }
    .status-dot { width: 8px; height: 8px; border-radius: 50%; background: #10b981; flex-shrink: 0; }
    .status-text { font-size: 13px; font-weight: 600; color: #065f46; letter-spacing: 0.2px; }
    .content { padding: 28px 32px 32px; }
    .greeting { font-size: 15px; color: #2d2d2d; line-height: 1.7; margin-bottom: 4px; }
    .greeting strong { color: #f7941d; }
    .intro-text { font-size: 13.5px; color: #666; line-height: 1.75; margin-bottom: 24px; }
    .review-summary { background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 8px; padding: 16px; margin-bottom: 20px; }
    .rating-label { font-size: 11px; font-weight: 600; color: #9ca3af; text-transform: uppercase; margin-bottom: 4px; }
    .rating-stars { color: #fbbf24; font-size: 16px; }
    .cta-btn { display: inline-block; background: #f7941d; color: #fff; text-decoration: none; font-size: 13.5px; font-weight: 600; padding: 11px 24px; border-radius: 7px; }
    .footer { background: #f9fafb; padding: 18px 32px; text-align: center; }
    .footer-copy { font-size: 11.5px; color: #aaa; }
  </style>
</head>
<body>
<div class="wrapper">
  <div class="container">
    <div class="header">
      <img class="header-logo" src="https://www.addressguru.in/images/logopng.png" alt="AddressGuru" />
    </div>
    <div class="status-bar">
      <div class="status-dot"></div>
      <span class="status-text">Review Published Successfully</span>
    </div>
    <div class="content">
      <p class="greeting">Hello, <strong>{{reviewerName}}</strong>,</p>
      <p class="intro-text">
        Thank you for sharing your experience with <strong>{{businessName}}</strong>. Your feedback helps others in the community make better choices.
      </p>
      <div class="review-summary">
        <div class="rating-label">Your Rating</div>
        <div class="rating-stars">{{ratingStars}}</div>
      </div>
      <a class="cta-btn" href="https://addressguru.ae/{{listingSlug}}">View Your Review</a>
    </div>
    <div class="footer">
      <div class="footer-copy">&copy; {{year}} AddressGuru UAE. All rights reserved.</div>
    </div>
  </div>
</div>
</body>
</html>
